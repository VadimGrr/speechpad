{
  "name": "speechpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local speech-to-text for Windows: two windows, dictation into any app, web SDK",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev -w @speechpad/web",
    "dev:web": "npm run dev -w @speechpad/web",
    "agent": "dotnet run --project apps/agent/Speechpad.Agent.csproj",
    "agent:build": "dotnet build apps/agent/Speechpad.Agent.csproj -c Release",
    "test:agent": "dotnet test apps/agent/tests/Speechpad.Agent.Tests.csproj",
    "example:embed": "node examples/embed/server.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
