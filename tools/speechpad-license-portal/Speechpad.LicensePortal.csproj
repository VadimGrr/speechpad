<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>speechpad-license-portal</AssemblyName>
    <RootNamespace>Speechpad.LicensePortal</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Speechpad.LicensePortal.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\apps\agent\Licensing\LicensePayload.cs" Link="LicensePayload.cs" />
    <Compile Include="..\..\apps\agent\Licensing\LicenseVerifier.cs" Link="LicenseVerifier.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
